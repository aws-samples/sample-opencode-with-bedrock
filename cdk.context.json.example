{
  "environment": "dev",
  "hostedZoneId": "Z0123456789ABCDEFGHIJ",
  "hostedZoneName": "example.com",
  "certificateDomain": "*.oc.example.com",
  "apiDomain": "oc.example.com",
  "webDomain": "downloads.oc.example.com",
  "shareDomain": "share.oc.example.com",

  "_comment_cognito": "For Cognito mode (default):",
  "authProvider": "cognito",

  "_comment_external": "For external OIDC provider mode (uncomment and replace cognito vars above):",
  "_authProvider": "external",
  "_oidcIssuer": "https://dev-123456.okta.com/oauth2/default",
  "_oidcAlbClientId": "your-alb-client-id",
  "_oidcCliClientId": "your-cli-client-id"
}
